---
import RoadmapLayout from "../../layouts/RoadmapLayout.astro";
import Quiz from "../../components/roadmap/Quiz";
---

<RoadmapLayout title="Buổi 35 - Ôn tập -고 있다 và -아/어 있다">
    <main class="h-screen bg-white overflow-hidden flex flex-col">
        <!-- Compact Header -->
        <div
            class="flex-shrink-0 px-4 md:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between"
        >
            <a
                href="/"
                class="inline-flex items-center gap-2 text-slate-500 hover:text-primary font-bold text-sm transition-colors"
            >
                <span>←</span> Quay về Lộ trình
            </a>
            <h1 class="text-lg font-bold text-slate-800 font-heading">Ôn tập -고 있다 và -아/어 있다</h1>
            <span
                class="px-3 py-1 bg-indigo-100 text-primary rounded-full text-xs font-bold tracking-widest uppercase border-l-2 border-r-2 border-indigo-300"
            >
                Buổi 35
            </span>
        </div>

        <!-- Quiz Container -->
        <div class="flex-1 overflow-auto p-4 md:p-6">
            <Quiz client:load sessionId={35} />
        </div>
    </main>
</RoadmapLayout>
