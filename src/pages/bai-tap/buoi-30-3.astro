---
import RoadmapLayout from '../../layouts/RoadmapLayout.astro';
import Quiz from '../../components/roadmap/Quiz';
---

<RoadmapLayout title="Bài tập Buổi 30 - Bài 3: Reading Dạng 1 TOPIK">
    <div class="max-w-5xl mx-auto px-4 py-8">
        <div class="mb-8 text-center">
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 mb-3">
                📖 Reading Dạng 1 TOPIK (21 câu)
            </h1>
            <p class="text-lg text-slate-600 mb-2">
                Ôn tập Dạng 1 TOPIK - Chọn đáp án đúng cho mỗi câu hỏi
            </p>
            <p class="text-sm text-slate-500">
                21 câu hỏi | Buổi 30 - Bài 3 | Ngày: 02/03/2026
            </p>
        </div>

        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6 rounded-r-lg">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-bold text-blue-800 mb-1">💡 Mục tiêu bài học</h3>
                    <div class="text-sm text-blue-700 space-y-1">
                        <p>• <strong>Reading Dạng 1:</strong> Đọc câu hỏi/bài đọc ngắn và chọn câu trả lời đúng</p>
                        <p>• <strong>Nội dung:</strong> Ôn tập 67 cấu trúc ngữ pháp từ Bài 01-67</p>
                        <p>• <strong>Kỹ năng:</strong> Đọc hiểu, phân tích ngữ pháp và chọn lựa chính xác</p>
                    </div>
                </div>
            </div>
        </div>

        <Quiz client:only="react" sessionId={30} quizSet="quiz3" />
    </div>
</RoadmapLayout>
